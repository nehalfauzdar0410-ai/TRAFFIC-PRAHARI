{
  "entities": {
    "User": {
      "title": "User",
      "description": "Core citizen or administrator account identity record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "role": { "type": "string", "enum": ["citizen", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "role", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private citizen profile containing contact PII and optional vehicle registration.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "mobileNumber": { "type": "string", "minLength": 7, "maxLength": 20 },
        "primaryVehicleReg": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "mobileNumber", "createdAt", "updatedAt"]
    },
    "RegisteredVehicle": {
      "title": "RegisteredVehicle",
      "description": "Vehicle registration linked to a citizen user after ownership declaration/verification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "registrationNumber": { "type": "string", "minLength": 4, "maxLength": 20, "pattern": "^[A-Z0-9\\-]+$" },
        "vehicleType": { "type": "string", "enum": ["Two-Wheeler", "Four-Wheeler", "Commercial", "Heavy Vehicle", "Other"] },
        "label": { "type": "string", "maxLength": 60 },
        "ownershipVerified": { "type": "boolean" },
        "verificationMethod": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "registrationNumber", "vehicleType", "ownershipVerified", "verificationMethod", "createdAt", "updatedAt"]
    },
    "TrafficReport": {
      "title": "TrafficReport",
      "description": "Citizen-submitted traffic violation complaint record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complaintCode": { "type": "string", "minLength": 6, "maxLength": 32, "pattern": "^TP-[0-9]{4}-[A-Z0-9]+$" },
        "reporterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "violationType": {
          "type": "string",
          "enum": [
            "Driving without helmet",
            "Driving without seatbelt",
            "Signal jumping",
            "Wrong-side driving",
            "Illegal parking",
            "Over-speeding",
            "Using a mobile phone while driving",
            "Triple riding",
            "Other violations"
          ]
        },
        "incidentDate": { "type": "string", "minLength": 8, "maxLength": 20 },
        "incidentTime": { "type": "string", "minLength": 4, "maxLength": 20 },
        "locationText": { "type": "string", "minLength": 3, "maxLength": 300 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "vehicleRegNumber": { "type": "string", "maxLength": 20 },
        "ocrExtractedPlate": { "type": "string", "maxLength": 20 },
        "ocrConfidence": { "type": "string", "enum": ["high", "medium", "low", "unreadable", "manual", "none"] },
        "ocrConfirmed": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 2000 },
        "status": {
          "type": "string",
          "enum": ["Submitted", "Under Review", "Verified", "Action Taken", "Resolved", "Rejected"]
        },
        "adminRemarks": { "type": "string", "maxLength": 1000 },
        "evidenceCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "complaintCode",
        "reporterId",
        "violationType",
        "incidentDate",
        "incidentTime",
        "locationText",
        "latitude",
        "longitude",
        "vehicleRegNumber",
        "ocrExtractedPlate",
        "ocrConfidence",
        "ocrConfirmed",
        "description",
        "status",
        "adminRemarks",
        "evidenceCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "ReportEvidence": {
      "title": "ReportEvidence",
      "description": "Metadata and protected retrieval reference for uploaded photographic evidence.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reportId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fileName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mimeType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"] },
        "fileSize": { "type": "integer" },
        "evidenceUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reportId", "reporterId", "fileName", "mimeType", "fileSize", "evidenceUrl", "createdAt"]
    },
    "ReportStatusHistory": {
      "title": "ReportStatusHistory",
      "description": "Chronological audit trail of status transitions for a complaint.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reportId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": {
          "type": "string",
          "enum": ["Submitted", "Under Review", "Verified", "Action Taken", "Resolved", "Rejected"]
        },
        "remarks": { "type": "string", "maxLength": 1000 },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorRole": { "type": "string", "enum": ["citizen", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reportId", "reporterId", "status", "remarks", "actorId", "actorRole", "createdAt"]
    },
    "ChallanRecord": {
      "title": "ChallanRecord",
      "description": "Challan record associated with a verified registered vehicle (demonstration or authorized API).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "challanNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "vehicleOwnerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vehicleRegNumber": { "type": "string", "minLength": 4, "maxLength": 20, "pattern": "^[A-Z0-9\\-]+$" },
        "violationCategory": { "type": "string", "minLength": 2, "maxLength": 120 },
        "incidentDate": { "type": "string", "minLength": 8, "maxLength": 30 },
        "locationText": { "type": "string", "minLength": 2, "maxLength": 240 },
        "amountInr": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Paid", "Disputed"] },
        "sourceName": { "type": "string", "minLength": 2, "maxLength": 160 },
        "isDemonstration": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "challanNumber",
        "vehicleOwnerId",
        "vehicleRegNumber",
        "violationCategory",
        "incidentDate",
        "locationText",
        "amountInr",
        "paymentStatus",
        "sourceName",
        "isDemonstration",
        "createdAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized traffic administration operator record.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "badgeId": { "type": "string", "minLength": 2, "maxLength": 40 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "badgeId", "active", "createdAt"]
    },
    "AdminActivityLog": {
      "title": "AdminActivityLog",
      "description": "Immutable audit log of all administrative verification and status actions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "adminEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "actionType": { "type": "string", "minLength": 2, "maxLength": 60 },
        "targetReportId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "targetComplaintCode": { "type": "string", "minLength": 2, "maxLength": 40 },
        "previousStatus": { "type": "string", "maxLength": 40 },
        "newStatus": { "type": "string", "maxLength": 40 },
        "remarks": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "adminUid",
        "adminEmail",
        "actionType",
        "targetReportId",
        "targetComplaintCode",
        "previousStatus",
        "newStatus",
        "remarks",
        "createdAt"
      ]
    },
    "VehicleReportSummary": {
      "title": "VehicleReportSummary",
      "description": "Anonymized violation summary indexed by vehicle registration number for verified owners only.",
      "type": "object",
      "properties": {
        "plateNumber": { "type": "string", "minLength": 4, "maxLength": 20, "pattern": "^[A-Z0-9\\-]+$" },
        "totalReports": { "type": "integer" },
        "summaries": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["plateNumber", "totalReports", "summaries", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Citizen and admin core role identity records."
    },
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Isolated PII profile records readable only by owner and admins."
    },
    "/registeredVehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/RegisteredVehicle" },
      "description": "Vehicles registered by authenticated owners for challan and notice checks."
    },
    "/trafficReports/{reportId}": {
      "schema": { "$ref": "#/entities/TrafficReport" },
      "description": "Submitted traffic violation complaints."
    },
    "/trafficReports/{reportId}/evidence/{evidenceId}": {
      "schema": { "$ref": "#/entities/ReportEvidence" },
      "description": "Photographic evidence metadata attached to a traffic report."
    },
    "/trafficReports/{reportId}/statusHistory/{historyId}": {
      "schema": { "$ref": "#/entities/ReportStatusHistory" },
      "description": "Audit timeline of complaint status updates."
    },
    "/challanRecords/{challanId}": {
      "schema": { "$ref": "#/entities/ChallanRecord" },
      "description": "Authorized or clearly labelled demonstration challan records linked to verified owners."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized administrator registry."
    },
    "/adminActivityLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminActivityLog" },
      "description": "Immutable administrative audit logs."
    },
    "/vehicleReportSummaries/{plateNumber}": {
      "schema": { "$ref": "#/entities/VehicleReportSummary" },
      "description": "Anonymized summary of verified complaints per plate, readable only via direct get by verified vehicle owner or admin."
    }
  }
}
